# ---------------------------------------------------------------
#  Jupiter Hotel PMS — environment template
#  Copy to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Jupiter_hotel

# --- Node API server ---
API_PORT=4000
# comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Vite only exposes variables that start with VITE_) ---
VITE_API_URL=http://localhost:4000/api
