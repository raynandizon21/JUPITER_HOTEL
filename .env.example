# ---------------------------------------------------------------
#  Jupiter Hotel PMS — environment template
#  Copy to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Jupiter_hotel

# --- Node API server ---
API_PORT=4020
# comma-separated origins allowed to call the API from another origin (optional;
# the app itself calls /api on the same origin, and Vite proxies /api in dev)
CORS_ORIGIN=http://localhost:3000
